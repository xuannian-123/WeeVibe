# Examples only. Configure the backend environment locally; never send these to the client.
# A dedicated WeeVibe PostgreSQL database is required. Do not use the bonsai database.
DATABASE_URL=postgresql://weego:EXAMPLE_ONLY@127.0.0.1:5432/weego?schema=public
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional server-to-server cloud identity adapter. Disabled until independently verified.
WEEGO_CLOUD_AUTH_ENABLED=false
WEEGO_CLOUD_AUTH_ENV_ID=
WEEGO_CLOUD_AUTH_KEY_ID=
# Ed25519 SPKI DER, base64. API receives PUBLIC key only; never the function private key.
WEEGO_CLOUD_AUTH_PUBLIC_KEY_B64=
WEEGO_CLOUD_AUTH_ALLOW_DEVTOOLS=false
# Server only. Optional until venue APIs are used; never inject into Taro builds.
AMAP_WEB_SERVICE_KEY=
# Mini-program build-time public HTTPS endpoint, NOT a secret. No default production host.
TARO_APP_API_BASE_URL=
# Optional native cloud HTTP function transport; no automatic fallback.
TARO_APP_API_TRANSPORT=https
TARO_APP_CLOUD_API_FUNCTION=
# Explicit opt-in after deployment verification. No automatic login fallback.
TARO_APP_LOGIN_MODE=code
TARO_APP_CLOUD_ENV_ID=
TARO_APP_CLOUD_LOGIN_FUNCTION=
