# Examples only. Configure the backend environment locally; never send these to the client.
# A dedicated Weego PostgreSQL database is required. Do not use the bonsai database.
DATABASE_URL=postgresql://weego:EXAMPLE_ONLY@127.0.0.1:5432/weego?schema=public
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Server only. Optional until venue APIs are used; never inject into Taro builds.
AMAP_WEB_SERVICE_KEY=
# Mini-program build-time public HTTPS endpoint, NOT a secret. No default production host.
TARO_APP_API_BASE_URL=
