generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String           @id @default(uuid()) @db.Uuid
  createdAt  DateTime         @default(now())
  identities WechatIdentity[]
  sessions   AuthSession[]
  testRecord UserTestRecord?
  managedActivities Activity[] @relation("CurrentManager")
  activityApplications ActivityApplication[]
  participations Participation[]
  mutationKeys ActivityMutationKey[]
  activityEvents ActivityEvent[]
  privateProfile PrivateProfile?
  favorites SavedVenue[]
  messageReads MessageRead[]
  ownedRequirementCollections RequirementSurvey[]
  requirementResponses RequirementSubmission[]
  requirementBudgets RequirementWriteBudget[]
  avatar UserAvatar?
  invitationSources InvitationSource[]
  receivedInvitations ReceivedInvitation[]
  sentHandovers ManagementHandover[] @relation("HandoverSender")
  receivedHandovers ManagementHandover[] @relation("HandoverRecipient")
  ownedGatherings Gathering[]
  gatheringMemberships GatheringMember[]
  gatheringGenerations GatheringGeneration[]
  gatheringSubmissionEvents GatheringSubmissionEvent[]
  gatheringNotifications GatheringNotificationRecipient[]
  gatheringSubscriptionGrants GatheringSubscriptionGrant[]
}

model WechatIdentity {
  id        String @id @default(uuid()) @db.Uuid
  appId     String
  openId    String
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appId, openId])
}

model AuthSession {
  tokenHash String   @id
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// One-use server-to-server login proofs; no OpenID, signature or raw proof body.
model CloudLoginUse {
  digest String @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model UserTestRecord {
  userId    String   @id @db.Uuid
  value     String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ActivitySegmentType {
  sport
  dinner
  karaoke
  drinks
  board_game
  custom
}

enum ActivityApplicationStatus {
  pending
  approved
  rejected
  withdrawn
}

enum ParticipationStatus {
  joined
  exited
}

enum SegmentVerificationStatus {
  unknown
  manual_checked
}

enum SegmentBookingStatus {
  unknown
  manual_booked
}

model Activity {
  id String @id @default(uuid()) @db.Uuid
  name String
  timezone String
  currentManagerId String @db.Uuid
  currentManager User @relation("CurrentManager", fields: [currentManagerId], references: [id], onDelete: Restrict)
  // Null only during this service's uncommitted create transaction.
  // A committed API-created activity always has one main segment.
  mainSegmentId String? @db.Uuid
  mainSegment Segment? @relation("MainSegment", fields: [id, mainSegmentId], references: [activityId, id], onDelete: NoAction, onUpdate: NoAction)
  revision Int @default(1)
  membershipRevision Int @default(1)
  managementRevision Int @default(1)
  mainRevision Int @default(1)
  confirmedMainRevision Int?
  confirmedPlanRevision Int?
  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  segments Segment[] @relation("ActivitySegments")
  applications ActivityApplication[]
  mutationKeys ActivityMutationKey[]
  events ActivityEvent[]
  requirementCollection RequirementSurvey?
  invitationSources InvitationSource[]
  handovers ManagementHandover[]
}

model Segment {
  id String @id @default(uuid()) @db.Uuid
  activityId String @db.Uuid
  activity Activity @relation("ActivitySegments", fields: [activityId], references: [id], onDelete: Restrict)
  mainForActivities Activity[] @relation("MainSegment")
  clientRef String
  position Int
  type ActivitySegmentType
  name String
  startsAt DateTime
  endsAt DateTime
  deadlineAt DateTime
  minimumParticipants Int
  capacity Int
  location Json
  fee Json
  requirements String
  planRevision Int @default(1)
  cancelledAt DateTime?
  verificationStatus SegmentVerificationStatus @default(unknown)
  bookingStatus SegmentBookingStatus @default(unknown)
  participations Participation[]
  applicationTargets ApplicationTarget[]

  @@unique([activityId, id])
  @@unique([activityId, clientRef])
  @@unique([activityId, position])
}

model ActivityApplication {
  id String @id @default(uuid()) @db.Uuid
  activityId String @db.Uuid
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  applicantUserId String @db.Uuid
  applicant User @relation(fields: [applicantUserId], references: [id], onDelete: Restrict)
  displayName String?
  status ActivityApplicationStatus @default(pending)
  createdAt DateTime @default(now())
  decidedAt DateTime?
  // Optional public invitation entry; legacy/direct records are not backfilled.
  invitationSourceId String? @db.Uuid
  invitationSource InvitationSource? @relation(fields: [activityId, invitationSourceId], references: [activityId, id], onDelete: NoAction, onUpdate: NoAction)
  targets ApplicationTarget[]
  participations Participation[]

  @@unique([activityId, id])
  @@index([activityId, status])
  @@index([applicantUserId])
  @@index([activityId, invitationSourceId])
}

model ApplicationTarget {
  activityId String @db.Uuid
  applicationId String @db.Uuid
  segmentId String @db.Uuid
  acceptedPlanRevision Int
  application ActivityApplication @relation(fields: [activityId, applicationId], references: [activityId, id], onDelete: Restrict)
  segment Segment @relation(fields: [activityId, segmentId], references: [activityId, id], onDelete: Restrict)

  @@id([applicationId, segmentId])
}

model Participation {
  id String @id @default(uuid()) @db.Uuid
  activityId String @db.Uuid
  segmentId String @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  segment Segment @relation(fields: [activityId, segmentId], references: [activityId, id], onDelete: Restrict)
  status ParticipationStatus @default(joined)
  // Version mismatch leaves this row occupying a seat, awaiting acceptance.
  acceptedPlanRevision Int?
  acceptedAt DateTime?
  displayName String?
  sourceApplicationId String? @db.Uuid
  sourceApplication ActivityApplication? @relation(fields: [activityId, sourceApplicationId], references: [activityId, id], onDelete: NoAction, onUpdate: NoAction)
  joinedAt DateTime @default(now())
  exitedAt DateTime?
  lateArrivalAt DateTime?
  lateNoticeAt DateTime?

  @@unique([segmentId, userId])
  @@index([activityId, userId])
}

model ActivityMutationKey {
  actorUserId String @db.Uuid
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  key String
  scope String
  requestHash String @db.Char(64)
  activityId String @db.Uuid
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([actorUserId, key])
}

model ActivityEvent {
  id String @id @default(uuid()) @db.Uuid
  activityId String @db.Uuid
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  actorUserId String @db.Uuid
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  type String
  revision Int
  detail Json
  createdAt DateTime @default(now())

  @@index([activityId, revision])
}

// Private self-service data; never included in activity snapshots.
model PrivateProfile {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  data Json
  updatedAt DateTime @updatedAt
}

model SavedVenue {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  data Json
  createdAt DateTime @default(now())
  @@id([userId, providerId])
}

model MessageRead {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  readAt DateTime @default(now())
  @@id([userId, messageId])
}

// JSON fields are validated by strict shared contracts before persistence.
model RequirementSurvey {
  id String @id @default(uuid()) @db.Uuid
  kind String
  ownerUserId String @db.Uuid
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  activityId String? @unique @db.Uuid
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  draft Json
  revision Int @default(1)
  status String @default("draft")
  deadlineAt DateTime?
  closedAt DateTime?
  finalSelection Json?
  creationKey String
  creationHash String @db.Char(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  responses RequirementSubmission[]
  @@unique([ownerUserId, creationKey])
  @@index([ownerUserId, updatedAt])
}

model RequirementSubmission {
  collectionId String @db.Uuid
  collection RequirementSurvey @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  revision Int
  // Per-person answer version; independent from the published questionnaire revision.
  responseVersion Int @default(1)
  publicAnswers Json
  privateOrigin Json?
  updatedAt DateTime @updatedAt
  @@id([collectionId, userId])
  @@index([userId, updatedAt])
}

// At most one current bucket per actor/scope, durable across instances/restarts.
model RequirementWriteBudget {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope String
  bucketStart DateTime
  count Int
  @@id([userId, scope])
}

model UserAvatar {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bytes Bytes
  contentType String
  digest String @db.Char(64)
  updatedAt DateTime @updatedAt
}

model InvitationSource {
  id String @id @default(uuid()) @db.Uuid
  activityId String @db.Uuid
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  inviterUserId String @db.Uuid
  inviter User @relation(fields: [inviterUserId], references: [id], onDelete: Restrict)
  inviterDisplayName String?
  inviterAvatarUrl String?
  createdAt DateTime @default(now())
  receivedInvitations ReceivedInvitation[]
  applications ActivityApplication[]
  @@unique([activityId, inviterUserId])
  @@unique([activityId, id])
}

model ReceivedInvitation {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitationId String @db.Uuid
  invitation InvitationSource @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  savedAt DateTime @default(now())
  @@id([userId, invitationId])
  @@index([userId, savedAt])
}


enum ManagementHandoverStatus {
  pending
  accepted
  rejected
  withdrawn
  invalidated
}

// Partial unique index for one pending/activity and CHECK constraints are maintained
// by migration SQL; Prisma 6 does not express a predicate-bearing unique index.
// HTML-based friend / team preparation. Legacy activities remain intact.
model Gathering {
  id String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  kind String
  details Json
  revision Int @default(1)
  creationKey String
  creationHash String
  currentGenerationId String? @db.Uuid
  finalGenerationId String? @db.Uuid
  finalPlanId String?
  finalizedAt DateTime?
  submissionSequence Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members GatheringMember[]
  generations GatheringGeneration[]
  submissionEvents GatheringSubmissionEvent[]
  subscriptionGrants GatheringSubscriptionGrant[]
  @@unique([ownerUserId, creationKey])
  @@index([ownerUserId, updatedAt])
}

model GatheringMember {
  gatheringId String @db.Uuid
  gathering Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  animalId String @default(dbgenerated("((ARRAY['cat','dog','fox','rabbit','bear','panda','koala','tiger','lion','penguin','owl','capybara'])[1 + floor(random() * 12)::int])"))
  avatarKey String?
  publicIntake Json
  privateIntake Json
  answers Json
  responseVersion Int @default(0)
  firstSubmissionSequence Int?
  lastWriteKey String?
  lastWriteHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([gatheringId, userId])
  @@unique([gatheringId, avatarKey])
  @@index([userId, updatedAt])
}

model GatheringGeneration {
  id String @id @default(uuid()) @db.Uuid
  gatheringId String @db.Uuid
  gathering Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  creatorUserId String @db.Uuid
  creator User @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  idempotencyKey String
  sourceHash String
  status String
  result Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([gatheringId, idempotencyKey])
  @@index([gatheringId, createdAt])
}

// One event for each committed answer version, not a projection of the latest answer.
model GatheringSubmissionEvent {
  id String @id @default(uuid()) @db.Uuid
  gatheringId String @db.Uuid
  gathering Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  actorUserId String @db.Uuid
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorVersion Int
  sequence Int
  action String
  createdAt DateTime @default(now())
  recipients GatheringNotificationRecipient[]
  @@unique([gatheringId, actorUserId, actorVersion])
  @@unique([gatheringId, sequence])
}

model GatheringNotificationRecipient {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event GatheringSubmissionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  outbox GatheringPushOutbox?
  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model GatheringPushOutbox {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @unique @db.Uuid
  recipient GatheringNotificationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  status String @default("pending")
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  leaseTokenHash String? @db.Char(64)
  leaseExpiresAt DateTime?
  grantId String? @unique @db.Uuid
  grant GatheringSubscriptionGrant? @relation(fields: [grantId], references: [id], onDelete: Restrict)
  lastErrorCode Int?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
}

// Each accepted click is an intent for one send; WeChat decides the actual permission.
model GatheringSubscriptionGrant {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gatheringId String @db.Uuid
  gathering Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  scope String
  appId String
  templateId String
  authorizationKey String
  consumedAt DateTime?
  createdAt DateTime @default(now())
  outbox GatheringPushOutbox?
  @@unique([userId, authorizationKey])
  @@index([userId, gatheringId, scope, appId, templateId, consumedAt], map: "GatheringSubscriptionGrant_available_idx")
}

model GatheringWorkerNonce {
  id String @id @default(uuid()) @db.Uuid
  scope String
  appId String
  nonceHash String @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([scope, appId, nonceHash])
  @@index([expiresAt])
}

model ManagementHandover {
  id String @id @default(uuid()) @db.Uuid
  activityId String @db.Uuid
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  fromUserId String @db.Uuid
  fromUser User @relation("HandoverSender", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId String @db.Uuid
  toUser User @relation("HandoverRecipient", fields: [toUserId], references: [id], onDelete: Restrict)
  fromManagementRevision Int
  creationKey String
  status ManagementHandoverStatus @default(pending)
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@unique([fromUserId, creationKey])
  @@index([activityId, createdAt])
  @@index([toUserId, status])
}
