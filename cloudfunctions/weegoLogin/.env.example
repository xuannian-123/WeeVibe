# Function-scoped settings only. Do not change original shared environment settings.
# This example is not loaded or deployed automatically.
WEEGO_CLOUD_AUTH_ENABLED=false
WECHAT_APP_ID=
WEEGO_CLOUD_AUTH_ENV_ID=
WEEGO_CLOUD_AUTH_KEY_ID=
# Ed25519 PKCS8 DER, base64. Generate a NEW Weego key; unrelated to the old AppSecret.
WEEGO_CLOUD_AUTH_PRIVATE_KEY_B64=
WEEGO_CLOUD_AUTH_ALLOW_DEVTOOLS=false
# Fixed public HTTPS origin only, without path, credentials, query or fragment.
WEEGO_API_BASE_URL=
